{
  "name": "automatenlab-repo",
  "version": "1.0.0",
  "private": true,
  "description": "AutomatenLab – Unterrichtseinheit „Maschinen, die Sprache verstehen“ (Automaten und formale Sprachen, Informatik Sek II) mit Web-App und Materialien",
  "scripts": {
    "app:serve": "cd app && python3 -m http.server 8080",
    "app:test": "cd app && npm test",
    "materials:build": "bash materials/build_all.sh",
    "materials:package": "node materials/scripts/package_dist.js",
    "qa:routes": "node qa/qa-routes.mjs http://localhost:8080/",
    "test": "npm run app:test"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "docx": "9.7.1",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "playwright": "1.56.0"
  }
}
